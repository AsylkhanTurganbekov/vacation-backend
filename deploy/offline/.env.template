POSTGRES_DB=vacation_db
POSTGRES_USER=vacation_user
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD

APP_JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
APP_JWT_EXPIRATION=86400000
APP_CORS_ALLOWED_ORIGIN_PATTERNS=*

BACKEND_EXTERNAL_PORT=8090
SERVER_CONTEXT_PATH=/
APP_OPENAPI_LOCAL_URL=http://SERVER_IP:8090
APP_OPENAPI_PROD_URL=

# Leave empty when Firebase is not used.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Put firebase-service-account.json into .secrets/ when it is used.
FIREBASE_SECRETS_DIR=./.secrets
