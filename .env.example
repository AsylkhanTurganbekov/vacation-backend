SPRING_PROFILES_ACTIVE=prod

SERVER_PORT=8081
SERVER_CONTEXT_PATH=/
BACKEND_EXTERNAL_PORT=8090

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/vacation_db
SPRING_DATASOURCE_USERNAME=vacation_user
SPRING_DATASOURCE_PASSWORD=change_me
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=30
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=10

POSTGRES_DB=vacation_db
POSTGRES_USER=vacation_user
POSTGRES_PASSWORD=change_me

# Only for local development with docker-compose.local.yml
POSTGRES_EXTERNAL_PORT=5433

APP_JWT_SECRET=change_me_to_a_long_random_secret
APP_JWT_EXPIRATION=86400000
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://your-frontend.example.com
APP_OPENAPI_LOCAL_URL=http://localhost:8090
APP_OPENAPI_PROD_URL=https://api.example.com
APP_BIOMETRIC_PROVIDER_NAME=mock-face-provider

# Optional only if you explicitly run the containerized nginx profile:
# docker compose --profile proxy up -d
NGINX_HTTP_PORT=8090
